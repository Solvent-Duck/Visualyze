{
  "version": 1,
  "id": "quality5-holdout-v1-2026-10-05",
  "description": "The quality5-development-v3 training and development cases, unchanged, plus the independently authored holdout-v1 cohort (eight held_out cases). The profile is the existing frozen quality5 profile with no coefficient change. This manifest, its fixtures and source identities are frozen through a new training run before the first scored held-out evaluation. Held-out results are reported, not used for tuning; any later engine change makes this cohort development evidence.",
  "profile": {
    "algorithms": [
      "Layered",
      "Floorplan",
      "Constrained",
      "Treemap"
    ],
    "continuity": "reported separately; no predecessor in initial-placement cases",
    "layout_version": 2,
    "normalization": "preferred-solid-volume-cuberoot-v1",
    "normalization_equations": {
      "aspect": "max enclosing dimension / min enclosing dimension - 1",
      "compactness": "cbrt(enclosing volume / reference_volume)",
      "congestion": "shared_lane_length/reference_length + crossing_points/max(1,displayed edge count)",
      "distortion": "sum(L1(actual_size,preferred_size) / reference_length for solids)",
      "length": "actual orthogonal routed length / reference_length",
      "occlusion": "min(1,pairwise projected solid overlap / total projected solid area) across XY/XZ/YZ",
      "reference_length": "max(1,cbrt(reference_volume))",
      "reference_volume": "max(1,sum(preferred_width*preferred_height*preferred_depth for projected solids))"
    },
    "projection": {
      "automatic_groups": true,
      "group_target": 32,
      "load_focus_detail": true,
      "max_children": 32,
      "max_references": 64,
      "max_relation_records": 4096,
      "peer_ceiling": 64,
      "visible_budget": 250
    },
    "quality_version": 5,
    "solver": {
      "clearance": 2,
      "feedback_candidates": 4,
      "gap": 12,
      "movement_weight": 0.08,
      "routed_candidates": 8,
      "size_candidates": 28
    },
    "weights": {
      "aspect_ratio": 1.5,
      "bends": 0.3,
      "compactness": 2.0,
      "congestion": 1.0,
      "distortion": 0.25,
      "occlusion": 2.0,
      "route_length": 1.0
    },
    "work_budget": 32
  },
  "provenance": {
    "synthetic": "Declared inputs; source records retain assumptions and omissions.",
    "public_references": "private/layout/fixtures/SOURCES.md",
    "historical_role": "Former held-out fixtures used during later repairs are development evidence.",
    "held_out": "private/layout/evaluation/holdout-v1/SELECTION.md (selection) and validation.json (pre-scoring corrections and final hashes)."
  },
