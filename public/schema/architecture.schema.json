{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:visualyze:architecture:0.1.0-draft.1",
  "title": "Visualyze architecture snapshot — draft 0.1",
  "description": "Draft semantic input contract consumed by the native Rust object simulator. Graph invariants and byte/depth limits additionally require the validation rules in architecture-format.md. Publication and revision synchronization remain separate from snapshot ingestion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "revision",
    "system_id",
    "snapshot",
    "entities",
    "relations",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft.1"
    },
    "model_id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "system_id": {
      "$ref": "#/$defs/id"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      },
      "minItems": 1,
      "maxItems": 512
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0,
      "maxItems": 4096
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "not": {
        "pattern": "[^a-z0-9._:-]"
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_revision",
        "coverage",
        "scope_description",
        "omissions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "enum": [
            "partial",
            "complete"
          ]
        },
        "scope_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        }
      }
    },
    "claim_rules": {
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "enum": [
                  "supported"
                ]
              }
            },
            "required": [
              "basis"
            ]
          },
          "then": {
            "required": [
              "evidence_ids"
            ],
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "enum": [
                  "inferred"
                ]
              }
            },
            "required": [
              "basis"
            ]
          },
          "then": {
            "required": [
              "rationale"
            ]
          }
        }
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "boundary",
        "basis"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "scope",
            "client",
            "service",
            "datastore",
            "interface",
            "concern",
            "deployment"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "boundary": {
          "enum": [
            "internal",
            "external",
            "unknown"
          ]
        },
        "subtype": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "technology": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "protocol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "basis": {
          "enum": [
            "supported",
            "inferred",
            "declared",
            "unknown"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/claim_rules"
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "scope",
                  "client",
                  "service",
                  "datastore",
                  "concern",
                  "deployment"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "protocol": false
            }
          }
        }
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "target",
        "basis"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "contains",
            "exposes",
            "requests",
            "reads",
            "writes",
            "depends_on",
            "applies_to",
            "implemented_by",
            "deployed_in",
            "publishes",
            "subscribes"
          ]
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "aspect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "dependency_phase": {
          "enum": [
            "runtime",
            "build",
            "startup",
            "unknown"
          ]
        },
        "necessity": {
          "enum": [
            "required",
            "optional",
            "unknown"
          ]
        },
        "basis": {
          "enum": [
            "supported",
            "inferred",
            "declared",
            "unknown"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/claim_rules"
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "applies_to"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "aspect"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "contains",
                  "exposes",
                  "requests",
                  "reads",
                  "writes",
                  "depends_on",
                  "implemented_by",
                  "deployed_in",
                  "publishes",
                  "subscribes"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "aspect": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "contains",
                  "exposes",
                  "requests",
                  "reads",
                  "writes",
                  "applies_to",
                  "implemented_by",
                  "deployed_in",
                  "publishes",
                  "subscribes"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "dependency_phase": false,
              "necessity": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "contains",
                  "exposes",
                  "applies_to",
                  "implemented_by",
                  "deployed_in"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "condition": false
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "locator": {
          "oneOf": [
            {
              "$ref": "#/$defs/source_locator"
            },
            {
              "$ref": "#/$defs/reference_locator"
            }
          ]
        }
      }
    },
    "source_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "const": "source"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "end_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "dependentRequired": {
        "end_line": [
          "start_line"
        ]
      }
    },
    "reference_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "reference"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        }
      }
    }
  }
}
